# =============================================================================
# VARIABLES DE ENTORNO - STARTAP PANAMÁ (PRODUCCIÓN & DESARROLLO)
# =============================================================================

# --- URL Base de la Aplicación ---
NEXT_PUBLIC_BASE_URL=https://startap.com.pa

# --- Pasarela de Pago: Tilopay (Procesamiento de Tarjetas de Crédito/Débito) ---
TILOPAY_API_USER=tu_usuario_api
TILOPAY_API_PASSWORD=tu_password_api
TILOPAY_API_KEY=tu_api_key

# --- Supabase (Base de Datos PostgreSQL, Auth y Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_public_key
# NUNCA expongas esta clave al cliente ni la subas al repositorio git:
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_key

# --- Transaccional de Correos: Resend ---
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM_EMAIL=starTAP Panamá <pedidos@startap.com.pa>
ORDER_NOTIFICATION_EMAIL=info@datakorex.com

# --- Acceso de Super Administrador (Separados por coma) ---
ADMIN_EMAILS=cotoss3@gmail.com,info@datakorex.com
NEXT_PUBLIC_ADMIN_EMAILS=cotoss3@gmail.com,info@datakorex.com

# --- Analíticas de Conversión: Meta Pixel (Facebook & Instagram Ads) ---
NEXT_PUBLIC_FB_PIXEL_ID=123456789012345

